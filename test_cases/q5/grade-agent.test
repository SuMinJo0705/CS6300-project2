class: "EvalAgentTest"

agentName: "ExpectimaxAgent"
agentArgs: "evalFn=better"
layoutName: "smallClassic"
maxTime: "20"
numGames: "10"

nonTimeoutMinimum: "0"
nonTimeoutThresholds: "10"

scoreThresholds: "500 500 500 1000 1000 1000 1000"

winsMinimum: "1"
winsThresholds: "1 5 5 5 10 10 10"

randomSeed: "0"
ghosts: "[RandomGhost(1)]"
